# -----------------------------------------------------------------------------
# TEST 1: Windows Hosts File Protection
# Verify the hosts file exists and is owned by SYSTEM
# -----------------------------------------------------------------------------
META
    esp_id `win-hosts-file-protected`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    control_framework `CIS`
    control `CIS-WIN-5.1`
    control_mapping `CIS:WIN-5.1`
    title `Windows hosts file must be protected`
    description `The hosts file is used for local DNS resolution and must be protected from unauthorized modification. It should be owned by the SYSTEM account.`
    platform `windows`
    criticality `high`
    agent_type `endpoint`
    tags `cis,windows,hosts,dns,network,security`
META_END

DEF
    OBJECT hosts_file
        path `C:\Windows\System32\drivers\etc\hosts`
    OBJECT_END

    STATE system_owned_readable
        exists boolean = true
        readable boolean = true
        owner_id string = `S-1-5-18`
    STATE_END

    CRI AND
        CTN file_metadata
            TEST at_least_one all
            STATE_REF system_owned_readable
            OBJECT_REF hosts_file
        CTN_END
    CRI_END
DEF_END
